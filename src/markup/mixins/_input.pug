mixin input(props)
  - var type = props.type || 'text';

  label.el-input&attributes(attributes)
    span.el-input__label= props.label
    if type === 'textarea'
      textarea.el-input__input(placeholder=props.placeholder, required=props.required, id=props.id, name=props.id)
    else
      input.el-input__input(type=type, placeholder=props.placeholder, required=props.required, id=props.id, name=props.id)
