section.team.container#team(data-aos="fade-up")
  .team__wrapper
    .team__content
      h2.team__title Команда Faust Consulting
      .team__description Мы отличаемся от большинства консультантов практическим опытом. Всё, о чём мы говорим, мы проживали сами в разных компаниях.
        | Помимо красивых фреймворков мы хорошо знаем лучших экспертов индустрии, готовых подключиться к решению ваших задач.
      .team__buttons
        +button({
          text: 'Наша команда',
          href: '#team',
          view: 'white'
        })
        +button({
          text: 'Начнем работать',
          href: '#callback',
          view: 'white-ghost'
        })
    .team__img
      img(src='img/team_img.png')
